{
  "expo": {
    "name": "교내 배달",
    "slug": "nv-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/delivery-icon.png",
    "scheme": "nvuser",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.nvuser.app"
    },
    "android": {
      "package": "com.nvuser.app",
      "adaptiveIcon": {
        "backgroundColor": "#C21F3A",
        "foregroundImage": "./assets/images/delivery-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/delivery-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C21F3A",
          "image": "./assets/images/delivery-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "리뷰에 사진을 첨부할 때만 사진 보관함에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
